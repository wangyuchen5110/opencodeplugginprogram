{
  "name": "opencode-skills-doctor",
  "version": "0.3.1",
  "description": "Local scanner, linter, fixer and updater for OpenCode skills, with an OpenCode plugin entry",
  "type": "module",
  "exports": {
    ".": "./src/plugin.mjs",
    "./plugin": "./src/plugin.mjs"
  },
  "bin": {
    "skills-doctor": "./bin/skills-doctor.mjs"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/doctor.test.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "README.zh-CN.md"
  ],
  "keywords": [
    "opencode",
    "skills",
    "lint",
    "fix",
    "cli",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wangyuchen5110/opencodeplugginprogram.git"
  },
  "license": "MIT"
}
